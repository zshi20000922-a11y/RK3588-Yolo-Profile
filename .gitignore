# Local builds and generated executables
/build*/
/install/
*.o
*.a
*.so
*.so.*
*.rknn
*.engine
*.onnx
*.onnx.data

# Datasets, frames, recordings, and per-image predictions
**/datasets/
**/frames/
*.nv12
*.mp4
*.jsonl

# Model checkpoints and generated detections
*.pt
*.pth
*.weights

# Only the reviewed, board-validated RKNN release artifacts are tracked.
!models/rk3588-int8/*.rknn

# Local machine and IDE files
.vscode/
.idea/
*.user
*.log
__pycache__/
.DS_Store
